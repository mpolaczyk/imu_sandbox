menu "IMU Mouse"

config IMU_BLE_SAMPLE_RATE_HZ
	int "BLE pose notification rate (Hz)"
	range 1 100
	default 50
	help
	  Maximum notification rate for the custom BLE pose service.

config IMU_BLE_SYNTHETIC_DATA
	bool "Send synthetic pose data over BLE"
	default n
	help
	  Stream a slowly rotating synthetic pose instead of the fused sensor pose.
	  The existing mouse continues to use real sensor fusion.

config SAMPLE_BT_HIDS_SECURITY
	bool "Bluetooth LE security"
	default y
	imply BT_PRIVACY
	select BT_SMP
	select BT_SETTINGS
	select FLASH
	select FLASH_PAGE_LAYOUT
	select FLASH_MAP
	select SETTINGS
	imply ZMS if (SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)
	imply NVS if !(SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)
	help
	  Enable Bluetooth LE security support.

config SAMPLE_BT_HIDS_SECURITY_MITM
	bool "Passkey display MITM protection"
	depends on SAMPLE_BT_HIDS_SECURITY
	depends on PRINTK
	default y
	help
	  Enable displaying passkey for Man-In-The-Middle (MITM) protection.
	  Implementation uses the "printk" function to display the passkey.

config SAMPLE_BT_DIRECTED_ADVERTISING
	bool "Directed advertising"
	default y
	depends on SAMPLE_BT_HIDS_SECURITY

endmenu

source "Kconfig.zephyr"
