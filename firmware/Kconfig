menu "IMU Mouse"

choice IM_BLE_DEVICE
	prompt "BLE device"
	default IM_BLE_DEVICE_GATT
	help
	  Only the selected device is compiled, initialized and advertised.
config IM_BLE_DEVICE_GATT
	bool "IMU pose streaming (custom GATT service)"
config IM_BLE_DEVICE_MOUSE
	bool "HID mouse"
endchoice

choice IM_BUTTON_MODE
	prompt "Button 1 function"
	default IM_BUTTON_MODE_CLICK
	help
	  What button 1 does once the passkey pairing is not pending.
config IM_BUTTON_MODE_CLICK
	bool "Left mouse button (click and hold)"
config IM_BUTTON_MODE_SENSITIVITY
	bool "Cycle cursor sensitivity"
endchoice

config IM_IMU_SAMPLE_RATE_HZ
	int "imu update rate"
	range 52 416
	default 208
	help
		12, 26, 52, 104, 208, 416, 833, 1666, 3332 and 6664 Hz

config IM_IMU_SKIP_CALIBRATION_MOTION_CHECK
	bool "Debug: accept motion during startup gyro calibration"
	default y
	help
	  Development only. Calibration completes after a fixed sample count even if
	  the device moves (e.g. on a train); expect gyro bias drift.

config IM_IMU_PRINT_SAMPLE
	bool "Print each IMU sample"
	default n

config IM_IMU_PRINT_PERIODIC_STATS
	bool "Periodic IMU statistics"
	default n

config IM_IMU_STATS_PERIOD_MS
	int "IMU statistics period in milliseconds"
	depends on IM_IMU_PRINT_PERIODIC_STATS
	default 1000

config IM_BLE_GATT_PRINT_PERIODIC_STATS
	bool "Periodic BLE GATT statistics"
	depends on IM_BLE_DEVICE_GATT
	default n

config IM_BLE_GATT_STATS_PERIOD_MS
	int "BLE GATT statistics period in milliseconds"
	depends on IM_BLE_GATT_PRINT_PERIODIC_STATS
	default 1000
		
config SAMPLE_BT_HIDS_SECURITY
	bool "Bluetooth LE security"
	default y
	imply BT_PRIVACY
	select BT_SMP
	select BT_SETTINGS
	select FLASH
	select FLASH_PAGE_LAYOUT
	select FLASH_MAP
	select SETTINGS
	imply ZMS if (SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)
	imply NVS if !(SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)
	help
	  Enable Bluetooth LE security support.

config SAMPLE_BT_HIDS_SECURITY_MITM
	bool "Passkey display MITM protection"
	depends on SAMPLE_BT_HIDS_SECURITY
	depends on PRINTK
	default y
	help
	  Enable displaying passkey for Man-In-The-Middle (MITM) protection.
	  Implementation uses the "printk" function to display the passkey.

config SAMPLE_BT_DIRECTED_ADVERTISING
	bool "Directed advertising"
	default n
	depends on SAMPLE_BT_HIDS_SECURITY

endmenu

source "Kconfig.zephyr"
